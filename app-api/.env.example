# Server
PORT=4000
NODE_ENV=development

# Database
DATABASE_URL=postgres://tagshop:tagshop@localhost:5433/tagshop

# Frontend (used for CORS allow-list and password-reset email links)
FRONTEND_URL=http://localhost:3000

# Public origin of the API (used to build absolute URLs for uploaded files).
# Defaults to the request host if not set.
# PUBLIC_API_URL=http://localhost:4000

# Object storage (S3-compatible: Backblaze B2, Cloudflare R2, MinIO). Required — the API
# refuses to start without it. Backblaze B2 needs its real region, not "auto".
S3_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
S3_REGION=eu-central-003
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# S3_SIGNED_URL_TTL_SEC=3600

# Salt for hashing viewer IPs in analytics.
ANALYTICS_IP_SALT=change-me

# Upload size caps.
# MAX_UPLOAD_BYTES=209715200
# MAX_IMAGE_BYTES=

# Google Sign-In — set this to your OAuth 2.0 Web Client ID from Google Cloud Console.
# Required only if you want the "Continue with Google" button to work.
# GOOGLE_CLIENT_ID=

# Email (SMTP). When unset, emails are logged to the API console (good enough for dev).
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="TagShop Video <no-reply@yourdomain.com>"

# --- Observability / messaging. docker-compose.yml sets these itself; only needed
# when running `npm start` outside Docker. All are optional.
# LOG_LEVEL=info
# METRICS_PORT=9464                       # internal /metrics (Prometheus)
# RABBITMQ_URL=amqp://tagshop:tagshop@localhost:5672   # unset → queues off, inline processing
# OTEL_SERVICE_NAME=tagshop-api
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SDK_DISABLED=true                  # no tracing without Tempo
